# --- Application ---
APP_ENV=development

# --- Database ---
# Local offline onboarding uses SQLite. Optional PostgreSQL dev port: 5433.
DATABASE_URL=sqlite:///./private/job_apply_agent.sqlite3
# Production (container-to-container):
# Compose requires POSTGRES_PASSWORD with no default in production.
POSTGRES_USER=jobbot
POSTGRES_PASSWORD=
POSTGRES_DB=jobbot
# DATABASE_URL=postgresql+psycopg://jobbot:<password>@postgres:5432/jobbot

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Private candidate files (created by `job-apply-agent onboard init`) ---
PROFILE_PATH=private/candidate/profile.json
ANSWER_BANK_PATH=private/candidate/answer-bank.json
SOURCE_BOARDS_PATH=private/candidate/source-boards.json
SEARCH_POLICY_PATH=private/candidate/search-policy.json
EXPERIENCE_LIBRARY_PATH=private/candidate/experiences.json
# Put a reviewed PDF/DOCX here, then set its path; no automatic parsing of claims.
RESUME_FILE=private/candidate/resume.pdf
# Compose mounts this directory read-only; use a filename relative to it.
CANDIDATE_DIR=./private/candidate
RESUME_FILENAME=resume.pdf
# Optional legacy inline values override files when non-empty. Keep them private.
PROFILE_JSON={}

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Paths ---
ARTIFACTS_DIR=private/artifacts
BROWSER_PROFILE_DIR=private/browser-profile
BROWSER_CHANNEL=chromium
BROWSER_HEADLESS=false
CUA_ENABLED=false
# Optional codex/lcu backends require a separately installed and authenticated runtime.
CUA_BACKEND=driver
CODEX_BINARY=codex
CODEX_MODEL=gpt-6-astra
CODEX_DRIVER_FALLBACK=true
CODEX_ACTION_TIMEOUT_SECONDS=10
BROWSER_PAGE_READY_TIMEOUT_SECONDS=30
# Required for driver/lcu; not required for the codex backend.
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_API_KEY=
GLM_MODEL=glm-5.3-flash
GLM_REASONING_EFFORT=high
CUA_MAX_STEPS=20
CUA_STEP_TIMEOUT_SECONDS=120
CUA_DRIVER_ATTACH_TIMEOUT_SECONDS=20
# Linux trusted browser input would foreground the window; DOM events keep the
# dedicated Xvfb browser in the background and are re-observed after each step.
CUA_BROWSER_INPUT_ROUTE=dom_event
# Non-secret candidate/application rules. Put reusable field values in Answer Bank.
CUA_INSTRUCTIONS=
SUBMIT_CONFIRMATION_TIMEOUT_SECONDS=20
EXPERIENCE_REASONING_ENABLED=false
# Keep full until real full/hybrid evaluation justifies retrieval.
# hybrid/auto additionally require the retrieval extra in the worker image.
EXPERIENCE_RETRIEVAL_MODE=full
EXPERIENCE_RETRIEVAL_TOP_K=5
EXPERIENCE_AUTO_CHAR_THRESHOLD=24000

# Cache contains private experience vectors; never commit it.
EXPERIENCE_CACHE_PATH=private/artifacts/experience-vectors.sqlite3

# --- Safety ---
ALLOW_LIVE_SUBMIT=false
# Required when ALLOW_LIVE_SUBMIT=true:
# LIVE_SUBMIT_ACK=I_UNDERSTAND_REAL_APPLICATIONS_WILL_BE_SENT

# --- Sources & Quota ---
SOURCE_BOARDS_JSON=[]
DAILY_FETCH_LIMIT=20
DAILY_AUTO_SUBMIT_LIMIT=10
HIGH_VALUE_THRESHOLD=65
COLLECTION_HOUR_UTC=6
